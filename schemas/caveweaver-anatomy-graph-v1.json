{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geoworld.local/schemas/caveweaver-anatomy-graph-v1.json",
  "title": "CaveWeaver engine-neutral attributed cave anatomy graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "coordinate_system",
    "unit_meters",
    "gravity_xyz",
    "nodes",
    "edges",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "geoworld.caveweaver-anatomy-graph.v1"},
    "asset_id": {"type": "string", "minLength": 1},
    "coordinate_system": {"type": "string", "minLength": 1},
    "unit_meters": {"type": "number", "exclusiveMinimum": 0},
    "gravity_xyz": {"$ref": "#/$defs/vector3"},
    "seed": {"type": "integer"},
    "geological_context": {"type": "object"},
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/edge"}
    },
    "boundary_ports": {
      "type": "array",
      "items": {"$ref": "#/$defs/boundaryPort"}
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "position_xyz_m", "role", "confidence"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "position_xyz_m": {"$ref": "#/$defs/vector3"},
        "role": {
          "enum": ["entrance", "junction", "chamber", "shaft_transition", "sump", "terminal", "ordinary"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "geological_unit": {"type": "string"},
        "water_state": {"enum": ["dry", "vadose", "phreatic", "sump", "unknown"]},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "crossSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance_along_edge_m",
        "center_xyz_m",
        "tangent_xyz",
        "up_xyz",
        "lateral_xyz",
        "half_extent_up_positive_m",
        "half_extent_up_negative_m",
        "half_extent_lateral_positive_m",
        "half_extent_lateral_negative_m",
        "confidence",
        "attribute_source"
      ],
      "properties": {
        "distance_along_edge_m": {"type": "number", "minimum": 0},
        "center_xyz_m": {"$ref": "#/$defs/vector3"},
        "tangent_xyz": {"$ref": "#/$defs/vector3"},
        "up_xyz": {"$ref": "#/$defs/vector3"},
        "lateral_xyz": {"$ref": "#/$defs/vector3"},
        "half_extent_up_positive_m": {"type": "number", "exclusiveMinimum": 0},
        "half_extent_up_negative_m": {"type": "number", "exclusiveMinimum": 0},
        "half_extent_lateral_positive_m": {"type": "number", "exclusiveMinimum": 0},
        "half_extent_lateral_negative_m": {"type": "number", "exclusiveMinimum": 0},
        "shape_exponent": {"type": "number", "minimum": 0.5, "maximum": 8, "default": 2},
        "floor_ceiling_asymmetry": {"type": "number", "minimum": -1, "maximum": 1},
        "wall_roughness": {"type": "number", "minimum": 0, "maximum": 1},
        "breakdown_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "wetness": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "attribute_source": {"enum": ["measured", "predicted", "simulated", "procedural", "user"]}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from_node", "to_node", "centerline_xyz_m", "cross_sections"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "from_node": {"type": "string", "minLength": 1},
        "to_node": {"type": "string", "minLength": 1},
        "hierarchy": {"type": "integer", "minimum": 0},
        "hydraulic_direction": {"enum": ["forward", "reverse", "bidirectional", "unknown"]},
        "centerline_xyz_m": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/vector3"}
        },
        "cross_sections": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/crossSection"}
        }
      }
    },
    "boundaryPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port_id", "node_id", "position_xyz_m", "minimum_clearance_m"],
      "properties": {
        "port_id": {"type": "string", "minLength": 1},
        "node_id": {"type": "string", "minLength": 1},
        "position_xyz_m": {"$ref": "#/$defs/vector3"},
        "minimum_clearance_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "generator_version", "content_sha256", "target_geometry_access"],
      "properties": {
        "generator": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_dataset_sha256": {"$ref": "#/$defs/sha256"},
        "target_geometry_access": {"type": "boolean"},
        "license": {"type": "string"}
      }
    }
  }
}
