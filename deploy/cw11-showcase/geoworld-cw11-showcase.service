[Unit]
Description=GeoWorld CW11.4 persistent Minecraft showcase
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/geoworld-store/worlds/showcase/caveweaver-cw11-success-seed104729-v1
ExecStart=/opt/geoworld-store/worlds/showcase/caveweaver-cw11-success-seed104729-v1/start-cw11-showcase.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGINT
SuccessExitStatus=0 130 143
Nice=10
IOSchedulingClass=idle
CPUQuota=300%
MemoryHigh=7G
MemoryMax=8G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
